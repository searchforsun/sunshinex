{
  "name": "sunshinex-agent",
  "version": "0.2.0",
  "description": "SunshineX 通用 AI Agent 工程化骨架（Harness/Loop/Graph 三层范式）",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "node scripts/clean-dist.js && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.json && node scripts/run-tests.js",
    "selfcheck": "node scripts/clean-dist.js && tsc -p tsconfig.json && node dist/cli/index.js selfcheck",
    "cli": "tsc -p tsconfig.json && node dist/cli/index.js",
    "prepublishOnly": "pnpm test && node dist/cli/index.js selfcheck"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.31",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cli-table3": "0.6.5",
    "highlight.js": "^11.12.0",
    "ink": "^3.2.0",
    "markdown-it": "^15.0.1",
    "react": "^18.3.1",
    "sqlite-vec": "^0.1.9",
    "string-width": "4.2.3"
  },
  "bin": {
    "sunshinex": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "MANUAL.md"
  ]
}
