{
  "name": "sunshinex-shell",
  "version": "0.3.1",
  "private": true,
  "description": "sunshinex desktop shell",
  "author": "sunshinex",
  "main": "out/main.cjs",
  "scripts": {
    "dev": "electron .",
    "build": "node esbuild.mjs",
    "build:app": "node esbuild.mjs --app",
