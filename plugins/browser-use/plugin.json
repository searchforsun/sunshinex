{
  "manifestVersion": 1,
  "id": "browser-use",
  "name": "浏览器操作",
  "version": "0.1.0",
  "description": "Playwright 驱动的浏览器自动化（a11y snapshot 主线，vision 兜底可开）",
  "defaultEnabled": false,
  "mcpServers": {
    "browser-use": {
      "command": "node",
      "cwd": ".",
      "args": [
        "server/bridge.js"
      ],
      "configDefaults": {
        "browser": "chrome",
        "headless": true,
        "builtin": false
      },
      "configArgs": {
        "browser": [
          "--browser",
          "{value}"
        ],
        "headless": [
          "--headless"
        ],
        "isolated": [
          "--isolated"
        ],
        "caps": [
          "--caps",
          "{value}"
        ],
        "userDataDir": [
          "--user-data-dir",
          "{value}"
        ],
        "cdpEndpoint": [
          "--cdp-endpoint",
          "{value}"
        ],
        "builtin": [
          "--builtin",
          "--builtin-meta",
          "{dataDir}/plugins/browser-use/builtin-cdp.json"
        ]
      }
    }
  },
  "skills": [
    "skills"
  ],
  "configSchema": {
    "browser": {
      "type": "string",
      "options": [
        "chrome",
        "chromium",
        "firefox",
        "webkit",
        "msedge"
      ],
      "description": "Agent 浏览器内核（默认 chrome）"
    },
    "headless": {
      "type": "boolean",
      "description": "无界面运行（默认开：不弹浏览器窗口，过程经快照与侧栏跟随；关=弹窗可视可手动接管）"
    },
    "isolated": {
      "type": "boolean",
      "description": "一次性 profile（默认关；开=关闭即忘登录态）"
    },
    "caps": {
      "type": "string",
      "options": [
        "config",
        "network",
        "storage",
        "devtools",
        "vision",
        "pdf",
        "testing"
      ],
      "multi": true,
      "description": "附加能力组（默认无=精简工具面；组越多工具越多、越占模型上下文）"
    },
    "userDataDir": {
      "type": "string",
      "description": "登录态 profile 目录（默认空=临时目录，建议 <dataDir>/plugins/browser-use/profile）"
    },
    "cdpEndpoint": {
      "type": "string",
      "description": "自己的浏览器 CDP 地址(非空即附着该浏览器,browser/headless 失效;如 http://127.0.0.1:9222,Chrome 需带 --remote-debugging-port 启动)"
    },
    "builtin": {
      "type": "boolean",
      "description": "内置侧栏浏览器(优先级高于 cdpEndpoint:起独立 Chromium,侧栏「内置浏览器」页实时镜像可点击;关=普通无头/有头模式)"
    }
  },
  "exposedTools": [
    "browser_close",
    "browser_resize",
    "browser_console_messages",
    "browser_handle_dialog",
    "browser_emulate_media",
    "browser_evaluate",
    "browser_file_upload",
    "browser_drop",
    "browser_find",
    "browser_fill_form",
    "browser_press_key",
    "browser_type",
    "browser_navigate",
    "browser_navigate_back",
    "browser_network_requests",
    "browser_network_request",
    "browser_run_code_unsafe",
    "browser_take_screenshot",
    "browser_snapshot",
    "browser_click",
    "browser_drag",
    "browser_hover",
    "browser_select_option",
    "browser_tabs",
    "browser_wait_for"
  ]
}