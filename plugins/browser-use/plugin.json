{
  "manifestVersion": 1,
  "id": "browser-use",
  "name": "浏览器操作",
  "version": "0.1.0",
  "description": "Playwright 浏览器自动化(无头/默认浏览器/内置侧栏)",
  "defaultEnabled": false,
  "mcpServers": {
    "browser-use": {
      "command": "node",
      "cwd": ".",
      "args": [
        "server/bridge.js",
        "--output-dir",
        "{dataDir}/plugins/browser-use/output",
        "--file-paths",
        "absolute"
      ],
      "configDefaults": {
        "browser": "chrome",
        "mode": "headless",
        "userDataDir": "{dataDir}/plugins/browser-use/profile"
      },
      "configArgs": {
        "browser": [
          "--browser",
          "{value}"
        ],
        "isolated": [
          "--isolated"
        ],
        "caps": [
          "--caps",
          "{value}"
        ],
        "userDataDir": [
          "--user-data-dir",
          "{value}"
        ],
        "mode": [
          "--mode",
          "{value}",
          "--builtin-meta",
          "{dataDir}/plugins/browser-use/builtin-cdp.json"
        ]
      }
    }
  },
  "skills": [
    "skills"
  ],
  "configSchema": {
    "mode": {
      "type": "string",
      "options": [
        "headless",
        "default",
        "builtin"
      ],
      "description": "浏览器形态"
    },
    "browser": {
      "type": "string",
      "options": [
        "chrome",
        "chromium",
        "firefox",
        "webkit",
        "msedge"
      ],
      "description": "无头档内核"
    },
    "isolated": {
      "type": "boolean",
      "description": "一次性 profile(默认关=登录态保留)"
    },
    "caps": {
      "type": "string",
      "options": [
        "config",
        "network",
        "storage",
        "devtools",
        "vision",
        "pdf",
        "testing"
      ],
      "multi": true,
      "description": "附加能力组"
    },
    "userDataDir": {
      "type": "string",
      "description": "profile 目录(默认 data/plugins/browser-use/profile)"
    }
  },
  "exposedTools": [
    "browser_close",
    "browser_resize",
    "browser_console_messages",
    "browser_handle_dialog",
    "browser_emulate_media",
    "browser_evaluate",
    "browser_file_upload",
    "browser_drop",
    "browser_find",
    "browser_fill_form",
    "browser_press_key",
    "browser_type",
    "browser_navigate",
    "browser_navigate_back",
    "browser_network_requests",
    "browser_network_request",
    "browser_run_code_unsafe",
    "browser_take_screenshot",
    "browser_snapshot",
    "browser_click",
    "browser_drag",
    "browser_hover",
    "browser_select_option",
    "browser_tabs",
    "browser_wait_for"
  ]
}