# SunshineX 模型配置（任意 OpenAI 协议兼容供应商，示例值与适配器默认值一致）
# 复制本文件为 .env 并填入真实值：copy .env.example .env （Windows） / cp .env.example .env
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# —— 知识库 / 向量检索（可选，均有代码内缺省；注释行示例不改变缺省行为）——
# 向量后端：local-json（缺省）/ sqlite-vec
#KB_BACKEND=sqlite-vec
# sqlite-vec 后端数据目录（缺省 .data/kb）
#KB_DATA_DIR=.data/kb
# embedding 供给（未配置时逐键回退上方 OPENAI_* 同名配置）
#EMBEDDING_BASE_URL=https://api.openai.com/v1
#EMBEDDING_API_KEY=sk-your-key-here
#EMBEDDING_MODEL=gpt-4o-mini
