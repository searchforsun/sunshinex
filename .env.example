# SunshineX 模型配置（任意 OpenAI 协议兼容供应商，示例值与适配器默认值一致）
# 复制本文件为 .env 并填入真实值：copy .env.example .env （Windows） / cp .env.example .env
# 放置位置两级任选：项目根 .env（项目级）或 ~/.sunshinex/.env（全局级，跨项目共享）
# 优先级：已导出的环境变量 > 项目级 .env > 全局级 ~/.sunshinex/.env
SUNSHINEX_API_KEY=sk-your-key-here
SUNSHINEX_BASE_URL=https://api.openai.com/v1
SUNSHINEX_MODEL=gpt-4o-mini

# —— 模型档位（可选，对标 Claude Code 的模型选择）：档位是用户级会话参数，系统不做自动换档 ——
# 会话内 /model small|medium|large 切换；--tier 启动参数或 SUNSHINEX_TIER 设缺省档
#SUNSHINEX_TIER=
# 按档绑定模型（OpenAI 协议，端点与密钥复用上方主配置；未配置档位回退主模型）
#SUNSHINEX_MODEL_SMALL=
#SUNSHINEX_MODEL_MEDIUM=
#SUNSHINEX_MODEL_LARGE=

# —— 结构化输出（可选，缺省开启）：动作信封以模型原生结构化输出约束 ——
# json_schema（缺省）：每次模型请求携带 response_format JSON Schema（动作信封协议镜像），端点侧约束输出形态；
# json：降级档，仅约束合法 JSON（端点不支持 json_schema 时）；off：显式关闭（请求体不带 response_format）
#SUNSHINEX_STRUCTURED_OUTPUT=json

# —— 知识库 / 向量检索（可选，均有代码内缺省；注释行示例不改变缺省行为）——
# 向量后端：local-json（缺省）/ sqlite-vec
#SUNSHINEX_KB_BACKEND=sqlite-vec
# sqlite-vec 后端数据目录（缺省 ~/.sunshinex/projects/<工作区>/data/kb）
#SUNSHINEX_KB_DATA_DIR=.data/kb

# 运行时数据目录覆盖（账本/记忆/学习技能/KB；缺省 ~/.sunshinex/projects/<工作区>/data，HOME 不可写回退项目 .data）
#SUNSHINEX_DATA_DIR=
# embedding 供给（未配置时逐键回退上方 SUNSHINEX_* 主模型同名配置）
#SUNSHINEX_EMBEDDING_BASE_URL=https://api.openai.com/v1
#SUNSHINEX_EMBEDDING_API_KEY=sk-your-key-here
#SUNSHINEX_EMBEDDING_MODEL=gpt-4o-mini

# —— 网页搜索（可选，websearch 工具；均有代码内缺省，注释行示例不改变缺省行为）——
# 引擎选型：duckduckgo（缺省，无 key）/ bing（需 SUNSHINEX_BING_API_KEY）
#SUNSHINEX_WEBSEARCH_PROVIDER=bing
# SUNSHINEX_BING_API_KEY=your-bing-key
# 引擎端点覆盖（自托管 SearXNG / 本地 mock 测试用；仅允许 http/https）
#SUNSHINEX_WEBSEARCH_ENDPOINT=http://127.0.0.1:8888/search

# 上下文窗口（可选，单位 tokens）：状态栏「上下文占用」的分母，同时是压缩预算的基准；
# 缺省 200000（reactor 内建缺省），按所用模型最大上下文设置，如 1M 窗口模型：SUNSHINEX_CONTEXT_WINDOW=1000000
#SUNSHINEX_CONTEXT_WINDOW=200000
