node_modules/
dist/
.pnpm-store/
.npm-cache/
.data/
.data-test/
*.log
.DS_Store
.superpowers/
# 遗留 .env（配置渠道已退役；保留忽略以防旧文件误提交密钥）
.env

# 项目级 .sunshinex/settings.json（env 块可含密钥，安全缺省对齐 .env；精确文件路径，不影响 .sunshinex/skills/ 入库）
.sunshinex/settings.json

# 长任务真实模型冒烟的演示目标项目（验证产物与运行痕迹不入库）
.longtask/
.corepack/

# 发版打包产物（scripts/release.mjs 的 npm pack 输出）
*.tgz

# 本地手动真实模型冒烟探针（开发机自用、不入库；门禁自检走 pnpm selfcheck / node scripts/release.mjs）
scripts/*probe*.js

# corepack 缓存（COREPACK_HOME 指向仓内时的产物）
.corepack-home/

.worktrees/

# G2 gui 子包（pnpm workspace）：vite 构建产物（../dist-gui）不入库——子包 node_modules 由上方裸 node_modules/ 覆盖（gitignore 无锚定语义）
dist-gui/
# 发版链拷入的 npm 包内 GUI 产物（pack 面，非源码）
gui-dist/
shell/out/
# H3-T3 打包面：esbuild daemon 束与 node-pty 实目录装配（dist script 前置生成，均构建产物）
shell/build/
# electron-builder 双产物（NSIS Setup + portable exe）
shell/release/

# G10:default 工作区(非文件类任务缺省落点,运行时数据)
default/

# GUI 截图验收物料（G 线视觉轮的实机截图,过程产物不入库）
.shots/

# gui 页签布局运行时数据(桌面/本地 GUI 按工作区落盘的 tabState,运行时产物不入库)
gui/sessions/

# O3 基准集真跑报告(scripts/eval-run.mjs 落档,每次带时间戳;数据入台账不入库)
eval-results/

# ZCode 工作流草稿/插件工作区数据(运行时产物不入库)
.zcode/
.data-visual/
.data-visual2/

# M3 computer-use 子包（pnpm workspace）：TS 编译产物就地落 server/（server/index.js 为 manifest 直启入口，产物不入库）
plugins/computer-use/server/**/*.js
plugins/browser-use/server/**/*.js
plugins/browser-use/browsers.json
plugins/browser-use/.playwright-mcp/
